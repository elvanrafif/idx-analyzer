# Salin ke .env dan isi. .env sudah di-gitignore — jangan pernah commit token.

# ── AI insight (halaman analyzer) ──
GLM_API_KEY=
GLM_MODEL=GLM-4.5-Flash
GLM_BASE_URL=

# ── Risk metrics ──
# Yield SBN 10 tahun sebagai proxy risk-free rate, dalam desimal.
RISK_FREE_RATE=0.065

# ── Screener + Telegram ──
# Token dari @BotFather. Chat id: kirim pesan ke bot, lalu buka
# https://api.telegram.org/bot<TOKEN>/getUpdates dan ambil message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Jeda antar request ke Yahoo, dalam detik. Naikkan kalau kena rate limit.
SCREENER_SLEEP=0.7

# ── Akses halaman screener ──
# Password untuk halaman /screener. Halaman meminta lewat prompt, lalu
# mengirimnya sebagai header X-Admin-Token di tiap request.
#
# Request dari server itu sendiri (loopback tanpa header proxy) selalu lolos
# tanpa password, jadi cron tidak terpengaruh.
#
# CATATAN JUJUR: ini guard tipis, bukan keamanan sungguhan. Password-nya lewat
# prompt di browser dan siapa pun yang membaca static/screener.js bisa
# memanggil API-nya langsung. Cukup untuk menghalau orang lewat; tidak cukup
# kalau isinya benar-benar rahasia. Untuk itu pakai Cloudflare Access atau
# basic auth di reverse proxy.
#
# Kosongkan = tidak ada password, dan akses dari luar loopback ditolak total.
SCREENER_ADMIN_TOKEN=123456789

# Ambang likuiditas/skor/bobot TIDAK di sini — semuanya per profil, diatur
# lewat halaman /screener (tombol ⚙ Setelan) dan tersimpan di profiles.json.
# Bawaannya ada di profiles.py. Lihat SCREENER.md.
